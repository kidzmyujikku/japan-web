rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      // Replace OWNER_UID_HERE with the UID of the account created in Firebase Auth.
      return request.auth != null && request.auth.uid == 'OWNER_UID_HERE' && request.auth.uid == uid;
    }
    match /users/{uid}/progress/{id} {
      allow read, create, update: if isOwner(uid) && id == 'main';
    }
    match /users/{uid}/events/{id} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && request.resource.data.id == id;
    }
    match /users/{uid}/attempts/{id} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && request.resource.data.id == id;
    }
  }
}
